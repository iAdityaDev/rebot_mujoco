<mujoco model="rebotarm_b601_stl">
  <compiler angle="radian" coordinate="local" eulerseq="xyz" meshdir="../meshes"/>
  <option timestep="0.001" gravity="0 0 -9.81" iterations="100" noslip_iterations="20"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.25 0.25 0.25" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.18 0.20 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <mesh name="base_link_hardware_black_mesh" file="colored_base_link_hardware_black.stl"/>
    <mesh name="base_link_matte_black_mesh" file="colored_base_link_matte_black.stl"/>
    <mesh name="base_link_silver_trim_mesh" file="colored_base_link_silver_trim.stl"/>

    <mesh name="link1_anodized_grey_mesh" file="colored_link1_anodized_grey.stl"/>
    <mesh name="link1_hardware_black_mesh" file="colored_link1_hardware_black.stl"/>
    <mesh name="link1_matte_black_mesh" file="colored_link1_matte_black.stl"/>

    <mesh name="link2_anodized_grey_mesh" file="colored_link2_anodized_grey.stl"/>
    <mesh name="link2_hardware_black_mesh" file="colored_link2_hardware_black.stl"/>
    <mesh name="link2_matte_black_mesh" file="colored_link2_matte_black.stl"/>
    <mesh name="link2_seeed_yellow_mesh" file="colored_link2_seeed_yellow.stl"/>

    <mesh name="link3_anodized_grey_mesh" file="colored_link3_anodized_grey.stl"/>
    <mesh name="link3_hardware_black_mesh" file="colored_link3_hardware_black.stl"/>
    <mesh name="link3_matte_black_mesh" file="colored_link3_matte_black.stl"/>
    <mesh name="link3_seeed_yellow_mesh" file="colored_link3_seeed_yellow.stl"/>

    <mesh name="link4_anodized_grey_mesh" file="colored_link4_anodized_grey.stl"/>
    <mesh name="link4_hardware_black_mesh" file="colored_link4_hardware_black.stl"/>
    <mesh name="link4_matte_black_mesh" file="colored_link4_matte_black.stl"/>
    <mesh name="link4_seeed_yellow_mesh" file="colored_link4_seeed_yellow.stl"/>

    <mesh name="link5_anodized_grey_mesh" file="colored_link5_anodized_grey.stl"/>
    <mesh name="link5_hardware_black_mesh" file="colored_link5_hardware_black.stl"/>
    <mesh name="link5_matte_black_mesh" file="colored_link5_matte_black.stl"/>

    <mesh name="link6_hardware_black_mesh" file="colored_link6_hardware_black.stl"/>
    <mesh name="link6_matte_black_mesh" file="colored_link6_matte_black.stl"/>
    <!-- This accessory STL is exported in millimetres. -->
    <mesh name="d405_305_mount_mesh" file="D405_305_Mount.stl" scale="0.001 0.001 0.001"/>
    <mesh name="realsense_d405_mesh" file="RealSense_D405.stl" scale="0.001 0.001 0.001"/>
    <!-- The D415 STL is already in metres. -->
    <mesh name="intel_d415_mesh" file="Intel D415.stl"/>
    <mesh name="soundbox_mesh" file="soundbox.stl" scale="0.001 0.001 0.001"/>

    <mesh name="gripper_base_hardware_black_mesh" file="colored_gripper_base_hardware_black.stl"/>
    <mesh name="gripper_base_metal_mesh" file="colored_gripper_base_metal.stl"/>
    <mesh name="gripper_base_seeed_yellow_mesh" file="colored_gripper_base_seeed_yellow.stl"/>
    <mesh name="finger_left_body_mesh" file="colored_left_finger_finger_black.stl"/>
    <mesh name="finger_left_carriage_mesh" file="colored_left_finger_carriage_grey.stl"/>
    <mesh name="finger_left_travel_stop_mesh" file="colored_left_finger_travel_stop_yellow.stl"/>
    <mesh name="finger_left_crossed_rack_mesh" file="colored_left_finger_rack_metal.stl"/>
    <mesh name="finger_right_body_mesh" file="colored_right_finger_finger_black.stl"/>
    <mesh name="finger_right_carriage_mesh" file="colored_right_finger_carriage_grey.stl"/>
    <mesh name="finger_right_travel_stop_mesh" file="colored_right_finger_travel_stop_yellow.stl"/>
    <mesh name="finger_right_crossed_rack_mesh" file="colored_right_finger_rack_metal.stl"/>

    <material name="anodized_grey_mat" rgba="0.831373 0.847059 0.831373 1" specular="0.72" shininess="0.90" metallic="0.88" roughness="0.18"/>
    <material name="hardware_black_mat" rgba="0.019608 0.027451 0.023529 1" specular="0.50" shininess="0.72" metallic="0.82" roughness="0.20"/>
    <material name="matte_black_mat" rgba="0.066667 0.074510 0.070588 1" specular="0.42" shininess="0.48" metallic="0.48" roughness="0.48"/>
    <material name="d405_305_mount_white_mat" rgba="0.95 0.95 0.95 1" specular="0.25" shininess="0.20" metallic="0" roughness="0.65"/>
    <material name="d405_camera_silver_mat" rgba="0.72 0.75 0.78 1" specular="0.70" shininess="0.75" metallic="0.85" roughness="0.25"/>
    <material name="d415_camera_silver_mat" rgba="0.72 0.75 0.78 1" specular="0.70" shininess="0.75" metallic="0.85" roughness="0.25"/>
    <material name="d405_camera_mirror_mat" rgba="0.10 0.12 0.14 1" specular="1" shininess="0.98" reflectance="0.70" metallic="0.15" roughness="0.02"/>
    <material name="seeed_yellow_mat" rgba="0.73 0.84 0.12 1" specular="0.22" shininess="0.26" metallic="0.18" roughness="0.34"/>
    <material name="silver_trim_mat" rgba="0.878431 0.890196 0.874510 1" specular="0.72" shininess="0.90" metallic="0.88" roughness="0.18"/>
    <material name="gripper_finger_black_mat" rgba="0.066667 0.074510 0.070588 1" specular="0.42" shininess="0.48" metallic="0.48" roughness="0.48"/>
    <material name="gripper_carriage_grey_mat" rgba="0.239 0.278 0.271 1" specular="0.30" shininess="0.30" metallic="0.62" roughness="0.38"/>
    <material name="gripper_rack_metal_mat" rgba="0.831373 0.847059 0.831373 1" specular="0.72" shininess="0.90" metallic="0.88" roughness="0.18"/>
    <material name="gripper_seeed_yellow_mat" rgba="0.725 0.835 0.118 1" specular="0.22" shininess="0.26" metallic="0.18" roughness="0.34"/>
    <material name="gripper_hardware_black_mat" rgba="0.019608 0.027451 0.023529 1" specular="0.50" shininess="0.72" metallic="0.82" roughness="0.20"/>
    <material name="gripper_base_metal_mat" rgba="0.831373 0.847059 0.831373 1" specular="0.72" shininess="0.90" metallic="0.88" roughness="0.18"/>
    <material name="tcp_mat" rgba="1.00 0.34 0.16 1"/>
    <texture name="floor_checker" type="2d" builtin="checker" rgb1="0.26 0.45 0.58" rgb2="0.12 0.30 0.43" width="512" height="512"/>
    <!-- MuJoCo renders one reflective geom; reserve it for the D405 face. -->
    <material name="floor_mat" texture="floor_checker" texrepeat="8 8" texuniform="true"/>
    <material name="table_mat" rgba="0.94 0.94 0.94 1" specular="0.18" shininess="0.25" metallic="0" roughness="0.65"/>
    <material name="soundbox_mat" rgba="0.285 0.529 0.936 1" specular="0.30" shininess="0.35" metallic="0" roughness="0.55"/>
    <material name="target_mat" rgba="1.00 0.55 0.12 0"/>
  </asset>

  <default>
    <joint damping="0.8" armature="0.01" limited="true"/>
    <geom contype="0" conaffinity="0" friction="0.8 0.1 0.1"/>
  </default>

  <worldbody>
    <light name="key_light" pos="0.45 -0.65 2.4" dir="-0.45 0.65 -1"/>
    <camera name="overhead_rgb" mode="fixed" pos="0.45 0 2.15" xyaxes="1 0 0 0 1 0" fovy="50"/>
    <geom name="floor" type="plane" size="1.0 1.0 0.02" material="floor_mat"/>

    <!-- 120 cm along Y, 90 cm along X, tabletop at 75 cm above the floor.
         The arm sits at the middle of the 120 cm edge at X=0. -->
    <body name="task_table" pos="0.45 0 0.73">
      <geom name="task_table_top" type="box" size="0.45 0.60 0.02" material="table_mat" contype="1" conaffinity="1" condim="6" friction="2.2 0.12 0.02" solref="0.003 1" solimp="0.98 0.995 0.0005"/>
      <geom name="task_table_leg_front_left" type="box" pos="-0.39 -0.54 -0.375" size="0.025 0.025 0.355" material="table_mat" contype="1" conaffinity="1"/>
      <geom name="task_table_leg_front_right" type="box" pos="-0.39 0.54 -0.375" size="0.025 0.025 0.355" material="table_mat" contype="1" conaffinity="1"/>
      <geom name="task_table_leg_back_left" type="box" pos="0.39 -0.54 -0.375" size="0.025 0.025 0.355" material="table_mat" contype="1" conaffinity="1"/>
      <geom name="task_table_leg_back_right" type="box" pos="0.39 0.54 -0.375" size="0.025 0.025 0.355" material="table_mat" contype="1" conaffinity="1"/>
    </body>

    <!-- Fixed D415 on the opposite X=0.90 m table edge, with its lens 0.80 m
         above the 0.75 m tabletop. Its +Y front faces inward and 60 degrees down. -->
    <body name="d415_stand" pos="0.90 0 0.75">
      <geom name="d415_stand_post" type="cylinder" pos="0 0 0.4095" size="0.008 0.4095"
            material="table_mat" mass="0" contype="0" conaffinity="0"/>
      <body name="d415_camera" pos="0 -0.038 0.81905" quat="0.6123724357 -0.3535533906 -0.3535533906 0.6123724357">
        <geom name="d415_camera_visual" type="mesh" mesh="intel_d415_mesh"
              material="d415_camera_silver_mat" mass="0" contype="0" conaffinity="0"/>
        <!-- MuJoCo cameras look along -Z; the STL's optical front is +Y. -->
        <camera name="d415_rgb" pos="0.038 0.022 0" quat="0.7071067812 0.7071067812 0 0" fovy="70"/>
      </body>
    </body>

    <!-- STL coordinates are millimetres; its bottom is at local Z=0. -->
    <body name="soundbox" pos="0.45 -0.0275 0.75">
      <freejoint/>
      <geom name="soundbox_visual" type="mesh" mesh="soundbox_mesh" material="soundbox_mat" mass="0" contype="0" conaffinity="0"/>
      <geom name="soundbox_collision" type="box" pos="0 0.0275 0.02921" size="0.05 0.0275 0.02921"
            rgba="0.285 0.529 0.936 0" group="5" contype="1" conaffinity="1" condim="6" mass="0.15"
            friction="2.0 0.12 0.02" solref="0.003 1" solimp="0.98 0.995 0.0005"/>
    </body>
    <body name="ik_target" mocap="true" pos="0.34 0 0.92">
      <geom name="ik_target_sphere" type="sphere" size="0.025" material="target_mat" contype="0" conaffinity="0"/>
      <site name="ik_target_site" pos="0 0 0" size="0.035" rgba="1 0.55 0.12 0"/>
    </body>

    <body name="base_link" pos="0.07 0 0.75">
      <inertial pos="-0.000007849 -0.0000011531 0.029841" mass="0.8366" diaginertia="0.00133040 0.00213119 0.00275877"/>
      <geom name="base_link_hardware_black_visual" type="mesh" mesh="base_link_hardware_black_mesh" material="hardware_black_mat"/>
      <geom name="base_link_matte_black_visual" type="mesh" mesh="base_link_matte_black_mesh" material="matte_black_mat"/>
      <geom name="base_link_silver_trim_visual" type="mesh" mesh="base_link_silver_trim_mesh" material="silver_trim_mat"/>

      <body name="link1" pos="-0.00008416 0 0.08465">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
        <inertial pos="0.0001136146 -0.0006163195 0.0236476373" mass="0.1613" diaginertia="0.00025207 0.00015464 0.00023416"/>
        <geom name="link1_anodized_grey_visual" type="mesh" mesh="link1_anodized_grey_mesh" material="anodized_grey_mat"/>
        <geom name="link1_hardware_black_visual" type="mesh" mesh="link1_hardware_black_mesh" material="hardware_black_mat"/>
        <geom name="link1_matte_black_visual" type="mesh" mesh="link1_matte_black_mesh" material="matte_black_mat"/>

        <body name="link2" pos="0.020084 0.031625 0.05555" quat="0.7071054825 -0.7071080799 0 0">
          <joint name="joint2" type="hinge" axis="0 0 -1" range="-3.14 0"/>
          <inertial pos="-0.1322562231 -0.0030617036 -0.0308306967" mass="1.3266" diaginertia="0.00073374 0.01255987 0.01281387"/>
          <geom name="link2_anodized_grey_visual" type="mesh" mesh="link2_anodized_grey_mesh" material="anodized_grey_mat"/>
          <geom name="link2_hardware_black_visual" type="mesh" mesh="link2_hardware_black_mesh" material="hardware_black_mat"/>
          <geom name="link2_matte_black_visual" type="mesh" mesh="link2_matte_black_mesh" material="matte_black_mat"/>
          <geom name="link2_seeed_yellow_visual" type="mesh" mesh="link2_seeed_yellow_mesh" material="seeed_yellow_mat"/>

          <body name="link3" pos="-0.264 0 0">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-3.14 0"/>
            <inertial pos="0.1210400358 -0.0536211077 -0.0310137855" mass="0.8353" diaginertia="0.00046807 0.00632695 0.00648221"/>
            <geom name="link3_anodized_grey_visual" type="mesh" mesh="link3_anodized_grey_mesh" material="anodized_grey_mat"/>
            <geom name="link3_hardware_black_visual" type="mesh" mesh="link3_hardware_black_mesh" material="hardware_black_mat"/>
            <geom name="link3_matte_black_visual" type="mesh" mesh="link3_matte_black_mesh" material="matte_black_mat"/>
            <geom name="link3_seeed_yellow_visual" type="mesh" mesh="link3_seeed_yellow_mesh" material="seeed_yellow_mat"/>

            <body name="link4" pos="0.2426 -0.054 -0.001625">
              <joint name="joint4" type="hinge" axis="0 0 1" range="-1.87 1.57"/>
              <inertial pos="0.0608200956 -0.0511711907 -0.0302994586" mass="0.52" diaginertia="0.00045986 0.00075258 0.00066742"/>
              <geom name="link4_anodized_grey_visual" type="mesh" mesh="link4_anodized_grey_mesh" material="anodized_grey_mat"/>
              <geom name="link4_hardware_black_visual" type="mesh" mesh="link4_hardware_black_mesh" material="hardware_black_mat"/>
              <geom name="link4_matte_black_visual" type="mesh" mesh="link4_matte_black_mesh" material="matte_black_mat"/>
              <geom name="link4_seeed_yellow_visual" type="mesh" mesh="link4_seeed_yellow_mesh" material="seeed_yellow_mat"/>

              <body name="link5" pos="0.078308 -0.0375 -0.03" quat="0.7071054825 -0.7071080799 0 0">
                <joint name="joint5" type="hinge" axis="0 0 1" range="-1.57 1.57"/>
                <inertial pos="-0.0050280206 0.0000017387 0.0386233236" mass="0.383" diaginertia="0.00019772 0.00021737 0.00017191"/>
                <geom name="link5_anodized_grey_visual" type="mesh" mesh="link5_anodized_grey_mesh" material="anodized_grey_mat"/>
                <geom name="link5_hardware_black_visual" type="mesh" mesh="link5_hardware_black_mesh" material="hardware_black_mat"/>
                <geom name="link5_matte_black_visual" type="mesh" mesh="link5_matte_black_mesh" material="matte_black_mat"/>

                <body name="link6" pos="0.028008 0 0.04" quat="0.7071054825 0 0.7071080799 0">
                  <joint name="joint6" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
                  <inertial pos="0.0000037642 -0.0001009088 0.0253308606" mass="0.3663" diaginertia="0.00015554 0.00015554 0.00013966"/>
                  <geom name="link6_hardware_black_visual" type="mesh" mesh="link6_hardware_black_mesh" material="hardware_black_mat"/>
                  <geom name="link6_matte_black_visual" type="mesh" mesh="link6_matte_black_mesh" material="matte_black_mat"/>

                  <!-- Mount on the upper (+X) side of the wrist, above the TCP in
                       the neutral pose. The clip is aligned with the wrist flange;
                       the outward offset clears the neighbouring link5 housing.
                       Fixed to link6 so the mount follows all six arm joints.
                       Visual only: accessory mass and collision geometry are not specified. -->
                  <body name="d405_305_mount" pos="0.054 0  0.0341" quat="0.7071067812 0 0 -0.7071067812">
                    <geom name="d405_305_mount_visual" type="mesh" mesh="d405_305_mount_mesh"
                          material="d405_305_mount_white_mat" mass="0" contype="0" conaffinity="0"/>
                    <!-- Camera back faces the angled pocket with 0.1 mm clearance.
                         The supplied mesh's front face is its local +Z plane. -->
                    <body name="d405_camera" pos="0 0.053076 0.017790" quat="0.9659258263 0.2588190451 0 0">
                      <geom name="d405_camera_visual" type="mesh" mesh="realsense_d405_mesh"
                            material="d405_camera_silver_mat" mass="0" contype="0" conaffinity="0"/>
                      <!-- Thin glass face leaves the rounded silver rim visible.
                           A box is needed because MuJoCo's native mirror rendering
                           supports the local +Z face of boxes, but not meshes. -->
                      <geom name="d405_camera_mirror" type="box" pos="0 0 0.0001"
                            size="0.0195 0.0195 0.0001" material="d405_camera_mirror_mat"
                            mass="0" contype="0" conaffinity="0"/>
                      <!-- MuJoCo cameras look along -Z; rotate this lens to face the
                           mesh's +Z front. The lens is 1 mm ahead of that face. -->
                      <camera name="d405_rgb" pos="0 0 0.001" quat="0 0 1 0" fovy="80"/>
                    </body>
                  </body>

                  <body name="end_link" pos="0 0 0.15539" quat="0.0000327579 0.7071080791 -0.0000327581 0.7071054818">
                    <inertial pos="-0.0737654296 -0.0000095081 0.0000070433" mass="0.5" diaginertia="0.00037354 0.00015830 0.00045353"/>
                    <geom name="gripper_base_hardware_black_visual" type="mesh" mesh="gripper_base_hardware_black_mesh" material="gripper_hardware_black_mat"/>
                    <geom name="gripper_base_metal_visual" type="mesh" mesh="gripper_base_metal_mesh" material="gripper_base_metal_mat"/>
                    <geom name="gripper_base_seeed_yellow_visual" type="mesh" mesh="gripper_base_seeed_yellow_mesh" material="gripper_seeed_yellow_mat"/>
                    <geom name="gripper_palm_collision" type="box" pos="-0.090 0 0" size="0.018 0.090 0.034" rgba="0.18 0.22 0.21 0.12" contype="1" conaffinity="1" condim="6" mass="0.02" friction="1.2 0.10 0.02" solref="0.003 1" solimp="0.98 0.995 0.0005"/>
                    <site name="tcp" pos="-0.105 0 0" size="0.008" rgba="1 0.34 0.16 1"/>

                    <body name="finger_left_link" pos="0 0 0">
                      <joint name="finger_left" type="slide" axis="0 1 0" range="0 0.05"/>
                      <inertial pos="0 0 0" mass="0.03" diaginertia="0.00001 0.00001 0.00001"/>
                      <geom name="finger_left_body_visual" type="mesh" mesh="finger_left_body_mesh" material="gripper_finger_black_mat"/>
                      <geom name="finger_left_carriage_visual" type="mesh" mesh="finger_left_carriage_mesh" material="gripper_carriage_grey_mat"/>
                      <geom name="finger_left_travel_stop_visual" type="mesh" mesh="finger_left_travel_stop_mesh" material="gripper_seeed_yellow_mat"/>
                      <geom name="finger_left_crossed_rack_visual" type="mesh" mesh="finger_left_crossed_rack_mesh" material="gripper_rack_metal_mat"/>
                      <geom name="finger_left_collision" type="box" pos="-0.105 0.014 0" size="0.045 0.007 0.020" rgba="0.18 0.22 0.21 0.20" contype="1" conaffinity="1" condim="6" mass="0.01" friction="6.0 0.25 0.04" solref="0.003 1" solimp="0.98 0.995 0.0005"/>
                      <geom name="finger_left_rear_collision" type="box" pos="-0.030 0.014 0" size="0.030 0.007 0.020" rgba="0.18 0.22 0.21 0.12" contype="1" conaffinity="1" condim="6" mass="0.006" friction="6.0 0.25 0.04" solref="0.003 1" solimp="0.98 0.995 0.0005"/>
                    </body>

                    <body name="finger_right_link" pos="0 0 0">
                      <joint name="finger_right" type="slide" axis="0 1 0" range="-0.05 0"/>
                      <inertial pos="0 0 0" mass="0.03" diaginertia="0.00001 0.00001 0.00001"/>
                      <geom name="finger_right_body_visual" type="mesh" mesh="finger_right_body_mesh" material="gripper_finger_black_mat"/>
                      <geom name="finger_right_carriage_visual" type="mesh" mesh="finger_right_carriage_mesh" material="gripper_carriage_grey_mat"/>
                      <geom name="finger_right_travel_stop_visual" type="mesh" mesh="finger_right_travel_stop_mesh" material="gripper_seeed_yellow_mat"/>
                      <geom name="finger_right_crossed_rack_visual" type="mesh" mesh="finger_right_crossed_rack_mesh" material="gripper_rack_metal_mat"/>
                      <geom name="finger_right_collision" type="box" pos="-0.105 -0.014 0" size="0.045 0.007 0.020" rgba="0.18 0.22 0.21 0.20" contype="1" conaffinity="1" condim="6" mass="0.01" friction="6.0 0.25 0.04" solref="0.003 1" solimp="0.98 0.995 0.0005"/>
                      <geom name="finger_right_rear_collision" type="box" pos="-0.030 -0.014 0" size="0.030 0.007 0.020" rgba="0.18 0.22 0.21 0.12" contype="1" conaffinity="1" condim="6" mass="0.006" friction="6.0 0.25 0.04" solref="0.003 1" solimp="0.98 0.995 0.0005"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <include file="rebotarm_b601_actuators.xml"/>
</mujoco>

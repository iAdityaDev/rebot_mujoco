<mujocoinclude>
  <!-- The physical gripper has one motor. Keep the two simulated fingers
       mirrored so one control value opens and closes both sides. -->
  <equality>
    <joint name="gripper_mirror" joint1="finger_left" joint2="finger_right"
           polycoef="0 -1 0 0 0"/>
  </equality>

  <!-- Position targets are in radians for joint1..joint6 and metres for the
       gripper. Force limits keep interactive and RL commands bounded. -->
  <actuator>
    <position name="joint1_position" joint="joint1" kp="80"
              ctrlrange="-2.8 2.8" forcerange="-30 30"/>
    <position name="joint2_position" joint="joint2" kp="100"
              ctrlrange="-3.14 0" forcerange="-30 30"/>
    <position name="joint3_position" joint="joint3" kp="80"
              ctrlrange="-3.14 0" forcerange="-30 30"/>
    <position name="joint4_position" joint="joint4" kp="50"
              ctrlrange="-1.87 1.57" forcerange="-15 15"/>
    <position name="joint5_position" joint="joint5" kp="40"
              ctrlrange="-1.57 1.57" forcerange="-12 12"/>
    <position name="joint6_position" joint="joint6" kp="30"
              ctrlrange="-3.14 3.14" forcerange="-10 10"/>
    <position name="gripper_position" joint="finger_left" kp="400"
              ctrlrange="0 0.05" forcerange="-20 20"/>
  </actuator>
</mujocoinclude>
